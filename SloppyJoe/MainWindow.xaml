<Window x:Class="SloppyJoe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SloppyJoe"
        mc:Ignorable="d"
        Title="Welcome to Sloppy Joe's Budget House o'Discount Sandwiches!" Height="350" Width="550">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition/>
           
        </Grid.ColumnDefinitions>
        <TextBox x:Name="item1" HorizontalAlignment="Right" FontSize="18" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="item2" HorizontalAlignment="Right" FontSize="18" Grid.Row="1" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="item3" HorizontalAlignment="Right" FontSize="18" Grid.Row="2" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="item4" HorizontalAlignment="Right" FontSize="18" Grid.Row="3" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="item5" HorizontalAlignment="Right" FontSize="18" Grid.Row="4" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="item6" HorizontalAlignment="Right" FontSize="18" Grid.Row="5" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="price1" HorizontalAlignment="Right" FontSize="18" Grid.Column="1" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="price2" HorizontalAlignment="Right" FontSize="18" Grid.Column="1" Grid.Row="1" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="price3" HorizontalAlignment="Right" FontSize="18" Grid.Column="1" Grid.Row="2" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="price4" HorizontalAlignment="Right" FontSize="18" Grid.Column="1" Grid.Row="3" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="price5" HorizontalAlignment="Right" FontSize="18" Grid.Column="1" Grid.Row="4" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="price6" HorizontalAlignment="Right" FontSize="18" Grid.Column="1" Grid.Row="5" BorderThickness="0,0,0,0"/>
        <TextBox x:Name="guacamole" HorizontalAlignment="Right" FontSize="18" FontStyle="Italic" Grid.ColumnSpan="2" Grid.Row="6" BorderThickness="0,0,0,0"/>
        
        

    </Grid>
</Window>
